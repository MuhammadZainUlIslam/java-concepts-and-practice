public class Main {
    public static void main(String[] args) {
        Functions add = (a, b) -> a + b;
        Functions multiply =(a,b) -> a*b;
        Functions subtract = (a,b) ->a-b;
        Functions divide = (a,b) ->a/b;
        System.out.println("A + B ="+add.operations(12,21));
        System.out.println("A * B ="+multiply.operations(6,20));
        System.out.println("A - B ="+subtract.operations(12,2));
        System.out.println("A / B ="+divide.operations(6,3));

        ArrayList<String> names = new ArrayList<>();
        names.add("Muhammad Zain Ul Islam");
        names.add("Raja Atif");
        names.add("Hafiz Abdullah");
        names.add("ALi Usama");
        names.add("Waseem Adnan");
        names.add("Ali Haider");
        names.add("Mustafa Haider");
        names.add("Malik Haider");
        System.out.println("Display All Names");
        names.forEach(n->{
            System.out.println(n);
        });
        System.out.println("--------Filtered Names--------");
        System.out.println("Starting with letter 'A'");
        names.stream().filter(n ->n.startsWith("A")).map(n -> n.toUpperCase()).forEach(n-> System.out.println(n));
        System.out.println("Starting with letter 'M'");
        names.stream().filter(n ->n.startsWith("M")).map(n->n.toUpperCase()).forEach(n-> System.out.println(n));
        names.stream().filter(n-> n.contains("Haider")).map(n-> n.toUpperCase()).forEach(n-> System.out.println(n));


