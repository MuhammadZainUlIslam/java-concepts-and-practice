public class Student {

    String Name;
    String Reg_No;
    String Section;
    int Age;

    public Student(String name, String regNo, String section, int age) {
        this.Name = name;
        this.Reg_No = regNo;
        this.Section = section;
        this.Age = age;
    }

    public void displayStudentRecord() {
        System.out.println("Name: " + Name);
        System.out.println("Registration No: " + Reg_No);
        System.out.println("Section: " + Section);
        System.out.println("Age: " + Age);
        System.out.println("----------------------------");
    }
}
